# OUR FIRST TINY AI NEURON

# Starting weight
weight = 0.5

# Learning speed
learning_rate = 0.01

# Training examples
training_data = [
    (1, 2),
    (2, 4),
    (3, 6),
    (4, 8)
]

# Train the AI
for epoch in range(1000):

    for x, correct_answer in training_data:

        # AI makes a prediction
        prediction = weight * x

        # Calculate the mistake
        error = prediction - correct_answer

        # Calculate how to adjust the weight
        gradient = 2 * error * x

        # Update the weight
        weight = weight - learning_rate * gradient

# Test the AI
print("Learned weight:", weight)

print("If input is 5, prediction is:", weight * 5)
