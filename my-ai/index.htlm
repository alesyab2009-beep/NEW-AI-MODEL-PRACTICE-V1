
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My AI - Python Coding Assistant</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0d1117;
            color: white;
            height: 100vh;
            display: flex;
        }

        .sidebar {
            width: 250px;
            background: #090d13;
            padding: 20px;
            border-right: 1px solid #252b35;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 30px;
            color: #58a6ff;
        }

        .new-chat {
            width: 100%;
            padding: 12px;
            background: #212936;
            color: white;
            border: 1px solid #394454;
            border-radius: 8px;
            cursor: pointer;
            margin-bottom: 20px;
        }

        .new-chat:hover {
            background: #303b4b;
        }

        .sidebar p {
            color: #8b949e;
            font-size: 13px;
            margin-top: 15px;
        }

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        header {
            padding: 20px;
            border-bottom: 1px solid #252b35;
            font-size: 18px;
            font-weight: bold;
        }

        .chat {
            flex: 1;
            overflow-y: auto;
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .welcome {
            margin: auto;
            text-align: center;
            max-width: 550px;
        }

        .welcome h1 {
            font-size: 34px;
            margin-bottom: 15px;
        }

        .welcome p {
            color: #9da7b3;
            line-height: 1.6;
        }

        .message {
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
            padding: 16px;
            border-radius: 12px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .user {
            background: #1c293a;
        }

        .assistant {
            background: #151b24;
            border: 1px solid #252b35;
        }

        .message pre {
            background: #080c12;
            padding: 15px;
            border-radius: 8px;
            overflow-x: auto;
            margin: 12px 0;
        }

        .message code {
            font-family: Consolas, monospace;
            color: #79c0ff;
        }

        .input-area {
            padding: 20px;
            border-top: 1px solid #252b35;
        }

        .input-box {
            max-width: 850px;
            margin: auto;
            display: flex;
            gap: 10px;
        }

        textarea {
            flex: 1;
            background: #161d27;
            color: white;
            border: 1px solid #394454;
            border-radius: 12px;
            padding: 15px;
            resize: none;
            height: 55px;
            outline: none;
            font-size: 15px;
        }

        textarea:focus {
            border-color: #58a6ff;
        }

        button {
            cursor: pointer;
        }

        .send {
            background: #238636;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0 22px;
            font-weight: bold;
        }

        .send:hover {
            background: #2ea043;
        }

        .send:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .hint {
            text-align: center;
            color: #727d8b;
            font-size: 12px;
            margin-top: 10px;
        }

        @media(max-width: 650px) {
            .sidebar {
                display: none;
            }

            .welcome h1 {
                font-size: 27px;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="logo">🐍 My AI</div>

        <button class="new-chat" onclick="newChat()">
            + New Chat
        </button>

        <p>PYTHON CODING ASSISTANT</p>
        <p>Write Python code</p>
        <p>Fix Python errors</p>
        <p>Explain Python code</p>
    </aside>

    <main class="main">

        <header>
            My AI <span style="color:#58a6ff;">/ Python Assistant</span>
        </header>

        <section class="chat" id="chat">

            <div class="welcome" id="welcome">
                <h1>What are we coding today?</h1>

                <p>
                    I'm My AI, your Python coding assistant.
                    I can write code, fix errors, and explain
                    programming concepts.
                </p>
            </div>

        </section>

        <div class="input-area">

            <div class="input-box">

                <textarea
                    id="message"
                    placeholder="Ask me anything about Python..."
                    onkeydown="handleKey(event)"
                ></textarea>

                <button class="send" id="send" onclick="sendMessage()">
                    Send
                </button>

            </div>

            <div class="hint">
                My AI can make mistakes. Always test generated code.
            </div>

        </div>

    </main>

<script>
    const chat = document.getElementById("chat");
    const input = document.getElementById("message");
    const sendButton = document.getElementById("send");

    function addMessage(text, type) {
        const welcome = document.getElementById("welcome");

        if (welcome) welcome.remove();

        const message = document.createElement("div");
        message.className = "message " + type;

        // Safely display text without interpreting HTML.
        message.textContent = text;

        chat.appendChild(message);
        chat.scrollTop = chat.scrollHeight;

        return message;
    }

    async function sendMessage() {
        const text = input.value.trim();

        if (!text || sendButton.disabled) return;

        addMessage(text, "user");

        input.value = "";
        sendButton.disabled = true;

        const loading = addMessage("My AI is thinking...", "assistant");

        try {
            const response = await fetch("/chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    message: text
                })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || "Request failed");
            }

            loading.textContent = data.reply;

        } catch (error) {
            loading.textContent =
                "Error: " + error.message +
                ". Check your server and API key.";
        }

        sendButton.disabled = false;
        input.focus();
        chat.scrollTop = chat.scrollHeight;
    }

    function handleKey(event) {
        if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    }

    function newChat() {
        chat.innerHTML = `
            <div class="welcome" id="welcome">
                <h1>What are we coding today?</h1>
                <p>
                    I'm My AI, your Python coding assistant.
                    I can write code, fix errors, and explain
                    programming concepts.
                </p>
            </div>
        `;
    }
</script>

</body>
</html>
